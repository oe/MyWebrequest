+// Reject pre-existing destination links, including dangling links and directory
+// components. Callers must still use private extraction directories: filesystem
+// path checks cannot exclude concurrent replacement of parent directories.
+function assertNoDestinationLinks(root, destination) {
+    const parts = pth.relative(root, destination).split(pth.sep).filter(Boolean);
+    let current = root;
+    for (let i = -1; i < parts.length; i++) {
+        if (i >= 0) current = pth.join(current, parts[i]);
+        try {
+            if (fsystem.lstatSync(current).isSymbolicLink()) {
+                throw new Error("Refusing ZIP extraction through symbolic link: " + current);
+            }
+        } catch (error) {
+            if (error.code !== "ENOENT") throw error;
+        }
+    }
+    return destination;
+}
