---
import { ArrowUpRight, ListRestart, Route, ShieldCheck, Zap } from '@lucide/astro';
import { guideGroupCopy, guideGroups, guideGroupSlugs, type GuideGroup, type Locale } from '../content';
import { localizedPath } from '../lib/routes';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const icons: Record<GuideGroup, typeof Zap> = {
  start: Zap,
  tasks: Route,
  upgrade: ListRestart,
  support: ShieldCheck,
};
---

<div class="guide-grid">
  {
    guideGroups.map((group) => {
      const copy = guideGroupCopy[locale][group];
      const Icon = icons[group];
      const destination = guideGroupSlugs[group][0];
      return (
        <a class="guide-link" href={localizedPath(locale, `guides/${destination}`)}>
          <Icon aria-hidden="true" size={20} stroke-width={1.7} />
          <span>
            <>
              <strong>{copy.title}</strong>
              <small>{copy.description}</small>
            </>
          </span>
          <ArrowUpRight class="guide-arrow" aria-hidden="true" size={16} />
        </a>
      );
    })
  }
</div>
