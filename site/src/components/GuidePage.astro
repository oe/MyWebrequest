---
import { ArrowLeft, ArrowRight, CodeXml } from '@lucide/astro';
import { guideCopy, guideSlugs, homeCopy, type GuideSlug, type Locale } from '../content';
import { githubUrl, localizedPath } from '../lib/routes';
import BaseLayout from '../layouts/BaseLayout.astro';
import GuideLinks from './GuideLinks.astro';

interface Props {
  locale: Locale;
  slug: GuideSlug;
}
const { locale, slug } = Astro.props;
const guide = guideCopy(locale, slug);
const copy = homeCopy[locale];
const index = guideSlugs.indexOf(slug);
const previous = index > 0 ? guideSlugs[index - 1] : undefined;
const next = index < guideSlugs.length - 1 ? guideSlugs[index + 1] : undefined;
---

<BaseLayout locale={locale} title={guide.title} description={guide.description} path={`guides/${slug}`}>
  <div class="guide-layout shell">
    <aside class="guide-sidebar">
      <a class="back-link" href={localizedPath(locale)}><ArrowLeft size={15} />My Webrequest</a>
      <p>{copy.navGuides}</p>
      <nav aria-label={copy.navGuides}>
        {
          guideSlugs.map((item) => (
            <a
              aria-current={item === slug ? 'page' : undefined}
              href={localizedPath(locale, `guides/${item}`)}
            >
              {guideCopy(locale, item).title}
            </a>
          ))
        }
      </nav>
    </aside>
    <article class="guide-article">
      <header>
        <p class="eyebrow">My Webrequest</p><h1>{guide.title}</h1><p class="lede">{guide.description}</p>
      </header>
      {
        guide.sections.map((section) => (
          <section>
            <h2>{section.title}</h2>
            {section.paragraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
            {section.code ? (
              <pre>
                <code>{section.code}</code>
              </pre>
            ) : null}
          </section>
        ))
      }
      <div class="guide-callout">
        <strong>{copy.trustTitle}</strong>
        <p>{copy.trustDescription}</p>
      </div>
      <nav class="guide-pagination" aria-label="Guide pagination">
        {
          previous ? (
            <a href={localizedPath(locale, `guides/${previous}`)}>
              <ArrowLeft size={15} />
              {guideCopy(locale, previous).title}
            </a>
          ) : (
            <span />
          )
        }
        {
          next ? (
            <a href={localizedPath(locale, `guides/${next}`)}>
              {guideCopy(locale, next).title}
              <ArrowRight size={15} />
            </a>
          ) : (
            <a href={githubUrl('/issues')}>
              <CodeXml size={15} />
              GitHub Issues
            </a>
          )
        }
      </nav>
    </article>
    <aside class="guide-related"><p>{copy.guidesTitle}</p><GuideLinks locale={locale} /></aside>
  </div>
</BaseLayout>
