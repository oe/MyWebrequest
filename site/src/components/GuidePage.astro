---
import { ArrowLeft, ArrowRight, ChevronDown, CodeXml } from '@lucide/astro';
import {
  guideCopy,
  guideGroupCopy,
  guideGroups,
  guideGroupSlugs,
  guideSlugs,
  homeCopy,
  type GuideSlug,
  type Locale,
} from '../content';
import { githubUrl, localizedPath } from '../lib/routes';
import BaseLayout from '../layouts/BaseLayout.astro';
import GuideSection from './GuideSection.astro';

interface Props {
  locale: Locale;
  slug: GuideSlug;
}
const { locale, slug } = Astro.props;
const guide = guideCopy(locale, slug);
const copy = homeCopy[locale];
const index = guideSlugs.indexOf(slug);
const previous = index > 0 ? guideSlugs[index - 1] : undefined;
const next = index < guideSlugs.length - 1 ? guideSlugs[index + 1] : undefined;
const currentGroup = guideGroups.find((group) => guideGroupSlugs[group].some((item) => item === slug));
const summarySection = slug === 'breaking-changes' ? guide.sections[0] : undefined;
const detailSections =
  slug === 'advanced-examples'
    ? [...guide.sections.slice(1, 5), guide.sections[0], ...guide.sections.slice(5)]
    : summarySection
      ? guide.sections.slice(1)
      : guide.sections;
const progressive = slug === 'advanced-examples' || slug === 'breaking-changes';
---

<BaseLayout locale={locale} title={guide.title} description={guide.description} path={`guides/${slug}`}>
  <div class="guide-layout shell">
    <aside class="guide-sidebar">
      <a class="back-link" href={localizedPath(locale)}><ArrowLeft size={15} />My Webrequest</a>
      <p>{copy.navGuides}</p>
      <nav class="guide-nav" aria-label={copy.navGuides}>
        {
          guideGroups.map((group) => (
            <details open={group === currentGroup}>
              <summary>
                <span>{guideGroupCopy[locale][group].title}</span>
                <ChevronDown aria-hidden="true" size={15} />
              </summary>
              <div>
                {guideGroupSlugs[group].map((item) => (
                  <a
                    aria-current={item === slug ? 'page' : undefined}
                    href={localizedPath(locale, `guides/${item}`)}
                  >
                    {guideCopy(locale, item).title}
                  </a>
                ))}
              </div>
            </details>
          ))
        }
      </nav>
    </aside>
    <article class="guide-article">
      <header>
        <p class="eyebrow">My Webrequest</p><h1>{guide.title}</h1><p class="lede">{guide.description}</p>
      </header>
      {summarySection ? <GuideSection section={summarySection} /> : null}
      {
        detailSections.map((section, sectionIndex) => (
          <GuideSection
            section={section}
            disclosure={progressive}
            number={slug === 'quick-start' ? sectionIndex + 1 : undefined}
          />
        ))
      }
      <div class="guide-callout">
        <strong>{copy.trustTitle}</strong>
        <p>{copy.trustDescription}</p>
      </div>
      <nav class="guide-pagination" aria-label="Guide pagination">
        {
          previous ? (
            <a href={localizedPath(locale, `guides/${previous}`)}>
              <ArrowLeft size={15} />
              {guideCopy(locale, previous).title}
            </a>
          ) : (
            <span />
          )
        }
        {
          next ? (
            <a href={localizedPath(locale, `guides/${next}`)}>
              {guideCopy(locale, next).title}
              <ArrowRight size={15} />
            </a>
          ) : (
            <a href={githubUrl('/issues')}>
              <CodeXml size={15} />
              GitHub Issues
            </a>
          )
        }
      </nav>
    </article>
  </div>
</BaseLayout>
