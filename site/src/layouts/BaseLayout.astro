---
import { Image } from 'astro:assets';
import icon from '../assets/app-icon.svg';
import ThemePicker from '../components/ThemePicker.astro';
import { homeCopy, localeNames, locales, type Locale } from '../content';
import { localeLanguageTag, localizedPath, withBase } from '../lib/routes';
import '../styles/global.css';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  path?: string;
}

const { locale, title, description, path = '' } = Astro.props;
const languageTag = localeLanguageTag(locale);
const copy = homeCopy[locale];
const pageTitle = title ? `${title} · RequestOrbit` : `RequestOrbit — ${copy.metaTitle}`;
const pageDescription = description ?? copy.description;
const canonical = new URL(localizedPath(locale, path), Astro.site);
const socialImage = new URL(withBase('app-icon.svg'), Astro.site);
const websiteSchema = {
  '@type': 'WebSite',
  name: 'RequestOrbit',
  alternateName: ['My Webrequest', 'MyWebrequest', 'request.forth.ink'],
  url: new URL('/', Astro.site),
};
const softwareSchema = {
  '@type': 'SoftwareApplication',
  name: 'RequestOrbit',
  url: canonical,
  applicationCategory: 'BrowserApplication',
  operatingSystem: 'Chrome, Microsoft Edge, Firefox',
  browserRequirements: 'Manifest V3 compatible browser',
  description: pageDescription,
  featureList: copy.capabilities.map((capability) => capability.title),
  inLanguage: languageTag,
  isAccessibleForFree: true,
  codeRepository: 'https://github.com/oe/MyWebrequest',
  license: 'https://github.com/oe/MyWebrequest/blob/master/LICENSE',
};
const schema = title
  ? {
      '@context': 'https://schema.org',
      '@graph': [
        softwareSchema,
        {
          '@type': 'TechArticle',
          headline: title,
          description: pageDescription,
          inLanguage: languageTag,
          mainEntityOfPage: canonical,
          isPartOf: {
            '@type': 'WebSite',
            name: 'RequestOrbit',
            url: new URL('/', Astro.site),
          },
          author: {
            '@type': 'Organization',
            name: 'RequestOrbit',
            url: 'https://github.com/oe/MyWebrequest',
          },
        },
      ],
    }
  : locale === 'en'
    ? { '@context': 'https://schema.org', '@graph': [websiteSchema, softwareSchema] }
    : { '@context': 'https://schema.org', ...softwareSchema };
---

<!doctype html>
<html lang={languageTag}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" content="#f7f9fc" />
    <script is:inline>
      (() => {
        const key = 'ui.theme';
        let preference = 'system';
        try {
          const stored = localStorage.getItem(key);
          if (stored === 'light' || stored === 'dark') preference = stored;
        } catch {}
        const resolved =
          preference === 'system'
            ? window.matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light'
            : preference;
        document.documentElement.dataset.themePreference = preference;
        document.documentElement.dataset.theme = resolved;
        document.documentElement.style.colorScheme = resolved;
        document
          .querySelector('meta[name="theme-color"]')
          ?.setAttribute('content', resolved === 'dark' ? '#111822' : '#f7f9fc');
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href={withBase('app-icon.svg')} />
    <link rel="canonical" href={canonical} />
    {
      locales.map((alternate) => (
        <link
          rel="alternate"
          hreflang={localeLanguageTag(alternate)}
          href={new URL(localizedPath(alternate, path), Astro.site)}
        />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={new URL(localizedPath('en', path), Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="RequestOrbit" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <title>{pageTitle}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href={localizedPath(locale)} aria-label="RequestOrbit home">
          <Image src={icon} alt="" width={34} height={34} />
          <span>RequestOrbit</span>
        </a>
        <nav aria-label="Primary navigation">
          <a href={localizedPath(locale, 'guides/quick-start')}>{copy.navGuides}</a>
          <a href={localizedPath(locale, 'guides/permissions')}>{copy.navPrivacy}</a>
          <a href="https://github.com/oe/MyWebrequest">{copy.openGithub}</a>
          <ThemePicker locale={locale} />
          <details class="locale-menu">
            <summary>{localeNames[locale]}</summary>
            <div class="locale-options">
              {
                locales.map((item) => (
                  <a aria-current={item === locale ? 'page' : undefined} href={localizedPath(item, path)}>
                    {localeNames[item]}
                  </a>
                ))
              }
            </div>
          </details>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="shell footer-inner">
        <div class="brand footer-brand">
          <Image src={icon} alt="" width={28} height={28} /><span>RequestOrbit</span>
        </div>
        <p>{copy.footer}</p>
        <a href="https://github.com/oe/MyWebrequest">GitHub</a>
      </div>
    </footer>
  </body>
</html>
